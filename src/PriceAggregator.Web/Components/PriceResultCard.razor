<div class="card">
    <div class="card-body">
        <h2 class="h5 card-title mb-3">@Price.Instrument price at @DisplayFormat.Timestamp(Price.Timestamp)</h2>

        <dl class="row mb-0">
            <dt class="col-sm-4">Aggregated price</dt>
            <dd class="col-sm-8 fs-4 fw-semibold">@DisplayFormat.Price(Price.Price) @DisplayFormat.QuoteCurrency(Price.Instrument)</dd>

            <dt class="col-sm-4">Result source</dt>
            <dd class="col-sm-8">
                @if (Price.Origin == PriceOrigin.Datastore)
                {
                    <span class="badge text-bg-success">Cache / datastore</span>
                }
                else
                {
                    <span class="badge text-bg-primary">External APIs</span>
                }
            </dd>

            <dt class="col-sm-4">Source prices</dt>
            <dd class="col-sm-8">
                <ul class="list-unstyled mb-0">
                    @foreach (var source in Price.Sources)
                    {
                        <li>@source.Source: @DisplayFormat.Price(source.Price)</li>
                    }
                </ul>
            </dd>
        </dl>

        @if (Price.UnavailableSources.Count > 0)
        {
            <div class="alert alert-warning mt-3 mb-0" role="status">
                Partial result without @string.Join(", ", Price.UnavailableSources), not saved to the datastore
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AggregatedPriceResponse Price { get; set; } = default!;
}
