{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Prices": "Data Source=prices.db"
  },
  "Prices": {
    "SupportedInstruments": [ "BTC/USD", "ETH/USD" ],
    "MaxHistoryRangeDays": 366
  },
  "PriceSources": {
    "Bitstamp": {
      "BaseAddress": "https://www.bitstamp.net/"
    },
    "Bitfinex": {
      "BaseAddress": "https://api-pub.bitfinex.com/"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5299", "https://localhost:7265" ]
  }
}
